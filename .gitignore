# Nota: config/nvim/lazy-lock.json SÍ se versiona (y está trackeado). Es el
# lockfile de lazy.nvim: versionarlo es lo que hace reproducible el set de
# plugins entre máquinas. Antes estaba listado aquí, contradiciendo al repo.

# Claude Code worktrees (artefactos temporales, nunca al repo)
.claude/

# Claude Code overrides locales por máquina (usar .example como plantilla)
config/claude/settings.local.json

# Escaparate web (web/): artefactos de build, nunca al repo.
# tools.generated.json NO va aquí: se versiona a propósito, para que el diff de
# "añadí un brew" se vea en la PR y el deploy no dependa del parser.
web/node_modules/
web/.next/
web/out/
# Caché incremental de tsc. La escribe `npx tsc --noEmit`, que es como se
# comprueban los tipos sin pasar por `next build`.
web/tsconfig.tsbuildinfo
