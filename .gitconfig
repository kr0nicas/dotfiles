[user]
    name = kr0nicas
    email = ochoa.j@gmail.com
[core]
    editor = nvim
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Catppuccin Mocha
[merge]
    conflictstyle = zdiff3
[diff]
    colorMoved = default
[color]
    ui = auto
[alias]
    st = status
    co = checkout
    br = branch
    cm = commit
[credential]
    helper = cache --timeout=3600

[includeIf "gitdir/i:/Users/"]
    path = ~/.gitconfig.macos
[includeIf "gitdir:~/Documents/Development/ITProject41/"]
	path = ~/.gitconfig-itproject41
[credential "https://github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
