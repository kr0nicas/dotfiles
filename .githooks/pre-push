#!/usr/bin/env bash
# Guardia de main + suite completa antes de empujar.
# Spec: docs/superpowers/specs/2026-08-08-arnes-trazabilidad-design.md
#
# GitHub también rechaza el push a main por branch protection; esto solo
# hace que el error llegue antes y con instrucciones.
set -uo pipefail

HOOK_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=.githooks/lib.sh
. "$HOOK_LIB_DIR/lib.sh"

# check_push_ref <ref> -> 1 si la ref es main
check_push_ref() {
    case "$1" in
        refs/heads/main)
            hook_err 'El flujo del repo es rama + PR; main no se empuja directo.'
            hook_info '  git switch -c feat/<ámbito>-<asunto>'
            hook_info '  git push -u origin HEAD && gh pr create --fill'
            hook_info ''
            hook_info 'Emergencia de verdad: git push --no-verify'
            return 1
            ;;
    esac
    return 0
}

# check_push_stdin — valida por stdin el formato que pasa git.
#
# Vive fuera de la guarda BASH_SOURCE a propósito: dentro, la única forma de
# probar el bucle sería ejecutar el hook entero, y eso dispara run_suites ->
# hooks.test.sh -> el hook otra vez. Recursión infinita.
check_push_stdin() {
    local rc=0 remote_ref
    # git pasa: <ref-local> <sha-local> <ref-remota> <sha-remoto>
    # Se mira la ref REMOTA: es la que se va a escribir. Mirando la local,
    # «git push origin HEAD:main» se colaba (la local es HEAD, no main) y
    # «git push origin main:backup» se bloqueaba sin motivo.
    while read -r _ _ remote_ref _; do
        [ -n "$remote_ref" ] || continue
        check_push_ref "$remote_ref" || rc=1
    done
    return "$rc"
}

# Las mismas suites que el paso "Suite de tests" de ci.yml, en el mismo
# formato "<intérprete> <archivo>". Antes el hook corría solo gcx y hooks, así
# que un fallo en las otras seis aparecía por primera vez en el CI. Un test de
# hooks.test.sh compara esta lista con la de ci.yml: si añades una suite en un
# sitio y no en el otro, falla.
PUSH_SUITES=(
    "zsh config/zsh/gcp.test.zsh"
    "zsh config/zsh/ssh.test.zsh"
    "zsh config/zsh/zshrc.test.zsh"
    "bash .githooks/hooks.test.sh"
    "bash lib/packages.test.sh"
    "bash lib/symlinks.test.sh"
    "bash lib/verify.test.sh"
    "bash config/claude/settings.test.sh"
    "bash scripts/changelog.test.sh"
)

# run_suites -> 1 si alguna suite falla
run_suites() {
    local rc=0 suite interp file
    for suite in "${PUSH_SUITES[@]}"; do
        interp=${suite%% *}
        file=${suite#* }
        [ -f "$file" ] || continue
        if ! has "$interp"; then
            hook_warn "$interp no está instalado; no se corrió $file"
            continue
        fi
        "$interp" "$file" >/dev/null 2>&1 \
            || { hook_err "La suite $file falla (corre: $suite)"; rc=1; }
    done
    return "$rc"
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    check_push_stdin || exit 1
    run_suites || exit 1
fi
