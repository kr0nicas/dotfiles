# ==============================================================================
# Brewfile.cloud — Cloud CLIs + IaC tooling
# Instalado por install.sh salvo que pases --no-cloud o --minimal.
# ==============================================================================

tap "hashicorp/tap"
tap "terraform-linters/tap"

# --- Cloud CLIs ---
brew "awscli"
brew "azure-cli"

# libpq da `psql`, `pg_dump` y `pg_isready` sin arrastrar el servidor de
# PostgreSQL. Es keg-only: brew no lo enlaza en el PATH y hay que llamarlo por
# ruta o añadir $(brew --prefix libpq)/bin. En Debian el equivalente que trae
# los mismos clientes es `postgresql-client`.
brew "libpq"

# --- IaC ---
#
# OpenTofu y no Terraform, y en las dos plataformas. Durante un tiempo cada SO
# instaló un motor distinto —macOS `hashicorp/tap/terraform`, Linux `tofu` desde
# GitHub Releases— y de esa asimetría colgaban tres defectos: `lib/verify.sh`
# comprobaba `tofu`, así que en cada Mac reportaba ❌ para siempre; `lib/menu.sh`
# prometía terraform al activar cloud, cosa falsa en Linux; y conform llamaba a
# `terraform_fmt`, que en Linux daba ENOENT en cada .tf.
#
# Se unifica en OpenTofu porque es lo que Linux ya había elegido, se instala
# igual en las dos plataformas sin tap de terceros, y evita la licencia BUSL.
# Es drop-in: lee el mismo HCL y `tfsec`/`tflint` siguen valiendo sin cambios.
brew "opentofu"
brew "hashicorp/tap/vault"
brew "tfsec"

# tflint salió de homebrew-core y su tap oficial lo publica como cask, no como
# fórmula — de ahí `cask` y el nombre completo. Mientras estuvo como `brew
# "tflint"` a secas, brew abortaba este archivo en esa línea y ni tfsec ni rtk
# ni el SDK de gcloud llegaban a instalarse.
#
# Es el linter de Terraform que declara nvim-lint, así que sin él nvim da
# ENOENT en cada .tf igual que daba en YAML antes de instalar yamllint.
cask "terraform-linters/tap/tflint"

# --- Agentes IA / tokens ---
brew "rtk"          # Rust Token Killer: comprime output de comandos para agentes (Claude Code hook)

# --- Casks ---
cask "gcloud-cli"
