# ==============================================================================
# Brewfile.gui — Apps GUI + VSCode + extensiones
# Instalado por install.sh salvo que pases --no-gui o --minimal.
# Util omitir en servidores VPS o instalaciones headless.
# ==============================================================================

# --- Apps GUI ---
cask "visual-studio-code"
cask "brave-browser"
cask "spotify"
cask "ngrok"
cask "postman"

# --- VS Code Extensions ---
vscode "anthropic.claude-code"
