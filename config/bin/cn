#!/usr/bin/env bash
# Wrapper for @continuedev/cli — uses nvm node without requiring nvm loaded
NODE_BIN="$(ls -d "$HOME/.nvm/versions/node"/*/bin 2>/dev/null | sort -V | tail -1)"
if [[ -z "$NODE_BIN" ]]; then
    echo "❌ nvm node not found. Install node via nvm first." >&2
    exit 1
fi
exec "$NODE_BIN/node" "$NODE_BIN/cn" "$@"
