#!/usr/bin/env bash
# Wrapper for @continuedev/cli — finds node via fnm without requiring a loaded shell
if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env --shell bash)" 2>/dev/null
    NODE_BIN="$(dirname "$(command -v node 2>/dev/null)")"
else
    NODE_BIN="$(ls -d "$HOME/.nvm/versions/node"/*/bin 2>/dev/null | sort -V | tail -1)"
fi

if [[ -z "$NODE_BIN" ]] || [[ ! -f "$NODE_BIN/cn" ]]; then
    echo "❌ node/cn not found. Install node via fnm first." >&2
    exit 1
fi
exec "$NODE_BIN/node" "$NODE_BIN/cn" "$@"
